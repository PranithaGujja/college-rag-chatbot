# ============================================================================
# Copy to .env  (or just run:  python scripts/init_env.py  which does it for you)
# NEVER commit the real .env file.
# ============================================================================

# --- Security ---------------------------------------------------------------
# Long random string. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
# Comma-separated list of frontend URLs allowed to call this API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional: also allow Vercel preview URLs, e.g.  https://college-portal-.*\.vercel\.app
CORS_ORIGIN_REGEX=
# Set to "production" on Render (hides /docs)
ENV=development

# --- Demo accounts (created at start-up; passwords are only stored hashed) ---
DEMO_STUDENT_ID=student1
DEMO_STUDENT_NAME=Demo Student
DEMO_STUDENT_PASSWORD=
DEMO_FACULTY_ID=faculty1
DEMO_FACULTY_NAME=Demo Faculty
DEMO_FACULTY_PASSWORD=

# --- Accounts that are re-created every time the server starts -------------------
# Needed on Render's free plan, whose disk is wiped on restart. Format: id|name|role|password ; id|name|role|password
# (name may be empty; role is student or faculty; password 8-72 characters). Keep it to about 20 people.
# Example:  EXTRA_USERS=3421|Dr. Rao|faculty|Choose-Pass-1;2303A52481||student|Choose-Pass-2
EXTRA_USERS=

# --- Sign-up access codes ----------------------------------------------------
# New students/faculty create their own account on the website, but only if they know the code for their role.
# Choose hard-to-guess codes. Give the STUDENT code to students and keep the FACULTY code private to faculty.
# Leave a code empty to close sign-up for that role.
STUDENT_SIGNUP_CODE=
FACULTY_SIGNUP_CODE=

# --- LLM: any OpenAI-compatible API ----------------------------------------
# Default = Groq free tier. Get a key (no credit card) at https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Used automatically if the main model is rate-limited or unavailable
# gpt-oss models are 'reasoning' models: keep effort low (fast, cheap) and leave room for thinking tokens.
# For non-gpt-oss models set LLM_REASONING_EFFORT= (empty).
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=1500
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# Alternative: Google Gemini free tier (OpenAI-compatible endpoint). Check model names at https://ai.google.dev/gemini-api/docs/models
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-3.5-flash
#   LLM_FALLBACK_MODEL=gemini-3.1-flash-lite
# Alternative: OpenRouter free models
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=openai/gpt-oss-20b:free

# --- Retrieval ---------------------------------------------------------------
# hybrid = keyword (BM25) + embeddings (FAISS).  bm25 = keyword only (uses almost no RAM; fallback for tiny servers)
RETRIEVAL_MODE=hybrid
EMBED_MODEL=BAAI/bge-small-en-v1.5
TOP_K=5
# Hybrid mode: a question goes to the LLM only if its best embedding score >= DENSE_MIN_SCORE
# (measured on the real handbooks: relevant questions score 0.67-0.87, off-topic 0.43-0.57).
# Keyword-only mode uses MIN_COVERAGE instead. Tune with scripts/eval_retrieval.py
DENSE_MIN_SCORE=0.62
MIN_COVERAGE=0.55

# --- Abuse protection (keeps the free LLM quota safe) ------------------------
CHAT_RATE_PER_MINUTE=10
MAX_QUESTION_CHARS=500
